# Copy this file to .env and replace placeholder values.

PORT=5000
NODE_ENV=production
# MongoDB replica set required for transactional sale and return processing.
MONGO_URI=mongodb://127.0.0.1:27017/pharmadesk?replicaSet=rs0&directConnection=true
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
CLIENT_URL=https://your-frontend-domain.example

# Optional email configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
