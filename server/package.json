{
  "name": "pharmadesk-server",
  "version": "1.0.0",
  "description": "Pharmadesk API server — Express + MongoDB backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --import ./env-loader.js server.js",
    "dev": "nodemon --import ./env-loader.js server.js",
    "test": "node --test",
    "seed": "node --import ./env-loader.js seed.js",
    "db:backup": "node --import ./env-loader.js utils/backupManager.js backup",
    "db:restore": "node --import ./env-loader.js utils/backupManager.js restore"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.2.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4",
    "tesseract.js": "^5.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  }
}
