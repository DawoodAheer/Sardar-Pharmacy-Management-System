{
  "name": "pharmadesk",
  "version": "1.0.0",
  "description": "Pharmadesk — Intelligent pharmacy management portal with role-based access",
  "main": "server/server.js",
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client --legacy-peer-deps",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "predev": "npx -y kill-port 5173 5174 6000 2>nul || echo Ports cleared",
    "dev": "concurrently --kill-others-on-fail \"npm run dev:server\" \"npm run dev:client\"",
    "seed": "npm run seed --prefix server",
    "db:backup": "npm run db:backup --prefix server",
    "db:restore": "npm run db:restore --prefix server",
    "start": "node server/server.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
