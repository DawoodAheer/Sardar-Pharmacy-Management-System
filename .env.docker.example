PORT=5000
NODE_ENV=production
MONGO_URI=mongodb://mongodb:27017/pharmadesk
JWT_ACCESS_SECRET=pharmadesk_super_secure_offline_jwt_access_secret_key_2026
JWT_REFRESH_SECRET=pharmadesk_super_secure_offline_jwt_refresh_secret_key_2026
